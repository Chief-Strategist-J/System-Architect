{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Platform (main.go)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/event-driven-platform/src/main.go",
      "cwd": "${workspaceFolder}/event-driven-platform",
      "dlvFlags": [
        "--check-go-version=false"
      ],
      "env": {
        "CONFIG_PATH": "${workspaceFolder}/event-driven-platform/config/default.yaml",
        "PORT": "8088",
        "ADMIN_PORT": "8089"
      }
    },
    {
      "name": "Debug Active Test Package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "cwd": "${workspaceFolder}/event-driven-platform",
      "dlvFlags": [
        "--check-go-version=false"
      ],
      "args": [
        "-test.v"
      ]
    },
    {
      "name": "Debug Test by Function Regex",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "cwd": "${workspaceFolder}/event-driven-platform",
      "dlvFlags": [
        "--check-go-version=false"
      ],
      "args": [
        "-test.v",
        "-test.run",
        "${input:testRegex}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "testRegex",
      "type": "promptString",
      "description": "Enter test function name regex (e.g. TestBloomFilterDeduplication)"
    }
  ]
}
